# Committed defaults for local development only. Real values come from the
# environment (compose) or .env.local. Never put production secrets here.
# Variable list: docs/CONVENTIONS.md §9.

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=dev-only-change-me-0123456789abcdef
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

DEFAULT_URI=http://localhost:8090
APP_PUBLIC_URL=http://localhost:8090
MEDIA_PUBLIC_BASE_URL=http://localhost:8090/media
FRONT_PUBLIC_URL=http://localhost:8090
TRUSTED_PROXIES=127.0.0.1,172.16.0.0/12

###> doctrine/doctrine-bundle ###
DATABASE_URL="postgresql://wave:wave@postgres:5432/wave?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/lock ###
LOCK_DSN=flock
###< symfony/lock ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=dev-only-jwt-passphrase
JWT_TTL=900
###< lexik/jwt-authentication-bundle ###

REFRESH_TOKEN_TTL=2592000
REFRESH_COOKIE_SECURE=0

STREAM_SIGNING_KEY=dev-only-stream-key-distinct-from-app-secret
STREAM_URL_TTL=300

S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=wave
S3_SECRET_KEY=wavewave
S3_USE_PATH_STYLE=1
S3_BUCKET_PRIVATE=wave-private
S3_BUCKET_PUBLIC=wave-public

###> symfony/mailer ###
MAILER_DSN=smtp://mailpit:1025
MAILER_FROM="Wave <no-reply@wave.local>"
###< symfony/mailer ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###
