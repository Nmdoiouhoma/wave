{
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4.27",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "api-platform/core": "^4",
        "doctrine/doctrine-bundle": "^3.3",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/orm": "^3.7",
        "dragonmantank/cron-expression": "^3",
        "egulias/email-validator": "^4",
        "gesdinet/jwt-refresh-token-bundle": "^1",
        "league/flysystem-aws-s3-v3": "^3",
        "league/flysystem-bundle": "^3",
        "lexik/jwt-authentication-bundle": "^3",
        "nelmio/cors-bundle": "^2.6",
        "phpdocumentor/reflection-docblock": "^6.0",
        "phpstan/phpdoc-parser": "^2.3",
        "symfony/clock": "7.4.*",
        "symfony/console": "7.4.*",
        "symfony/doctrine-messenger": "7.4.*",
        "symfony/dotenv": "7.4.*",
        "symfony/expression-language": "7.4.*",
        "symfony/flex": "^2",
        "symfony/framework-bundle": "7.4.*",
        "symfony/lock": "7.4.*",
        "symfony/mailer": "7.4.*",
        "symfony/messenger": "7.4.*",
        "symfony/mime": "7.4.*",
        "symfony/monolog-bundle": "^4.1",
        "symfony/process": "7.4.*",
        "symfony/property-access": "7.4.*",
        "symfony/property-info": "7.4.*",
        "symfony/rate-limiter": "7.4.*",
        "symfony/runtime": "7.4.*",
        "symfony/scheduler": "7.4.*",
        "symfony/security-bundle": "7.4.*",
        "symfony/serializer": "7.4.*",
        "symfony/string": "7.4.*",
        "symfony/translation": "7.4.*",
        "symfony/twig-bundle": "7.4.*",
        "symfony/uid": "7.4.*",
        "symfony/validator": "7.4.*",
        "symfony/yaml": "7.4.*"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true,
            "phpstan/extension-installer": true
        },
        "bump-after-update": true,
        "sort-packages": true,
        "platform": {
            "php": "8.4.27"
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "test": [
            "@php bin/phpunit"
        ],
        "phpstan": [
            "@php bin/console cache:warmup --env=dev --quiet",
            "@php vendor/bin/phpstan analyse --memory-limit=1G"
        ],
        "cs": [
            "@php vendor/bin/php-cs-fixer check --config=.php-cs-fixer.dist.php"
        ],
        "cs-fix": [
            "@php vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.dist.php"
        ],
        "qa": [
            "@cs",
            "@phpstan",
            "@test"
        ],
        "jwt-keys": [
            "@php bin/console lexik:jwt:generate-keypair --skip-if-exists",
            "@php -r \"chmod('config/jwt/private.pem', 0600);\""
        ]
    },
    "conflict": {
        "symfony/symfony": "*",
        "symfony/security-http": "<7.4.13",
        "symfony/security-bundle": "<7.4.13",
        "symfony/http-kernel": "<7.4.13"
    },
    "extra": {
        "symfony": {
            "allow-contrib": true,
            "require": "7.4.*",
            "docker": false
        }
    },
    "require-dev": {
        "dama/doctrine-test-bundle": "^8",
        "friendsofphp/php-cs-fixer": "^3",
        "league/flysystem-memory": "^3",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-phpunit": "^2.1",
        "phpstan/phpstan-symfony": "^2.1",
        "phpunit/phpunit": "^13.4.5",
        "symfony/browser-kit": "7.4.*",
        "symfony/css-selector": "7.4.*",
        "symfony/http-client": "7.4.*",
        "symfony/maker-bundle": "^1"
    }
}
