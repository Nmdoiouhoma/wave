parameters:
    level: 8
    paths:
        - src/
        - tests/
    excludePaths:
        - tests/bootstrap.php
    symfony:
        containerXmlPath: var/cache/dev/App_KernelDevDebugContainer.xml
    doctrine:
        objectManagerLoader: tests/object-manager.php
    # The php container is capped at 512 MB: unbounded workers get OOM-killed.
    parallel:
        maximumNumberOfProcesses: 2
