# Wave — environment for docker compose (CONVENTIONS §9).
# `make env` copies this file to .env and fills every "change-me" secret with
# random bytes. Never commit .env.

# --- Host ports (dev) --------------------------------------------------------
WAVE_HTTP_PORT=8090
MAILPIT_UI_PORT=8027
POSTGRES_TOOLS_PORT=5436
# Compose networks. `storage` links nginx and MinIO only; the wave-private
# bucket policy allows anonymous reads (audio/ only) from nginx's fixed IP.
WAVE_INTERNAL_SUBNET=172.30.90.0/24
WAVE_STORAGE_SUBNET=172.30.91.0/24
WAVE_NGINX_STORAGE_IP=172.30.91.10

# --- Symfony -----------------------------------------------------------------
APP_ENV=dev
APP_SECRET=change-me
APP_PUBLIC_URL=http://localhost:8090
MEDIA_PUBLIC_BASE_URL=http://localhost:8090/media
FRONT_PUBLIC_URL=http://localhost:8090
# The SPA is served through nginx on the same origin as the API.
CORS_ALLOW_ORIGIN='^http://localhost:8090$'
# nginx IP only, and only if something in front of nginx forwards the client
# IP. Empty by default: nginx is the edge, REMOTE_ADDR is the real client and
# nginx overwrites X-Forwarded-* (F1). Never a whole subnet.
TRUSTED_PROXIES=

# --- Database ----------------------------------------------------------------
POSTGRES_DB=wave
POSTGRES_USER=wave
POSTGRES_PASSWORD=wave
DATABASE_URL=postgresql://wave:wave@postgres:5432/wave?serverVersion=16&charset=utf8
LOCK_DSN=postgresql+advisory://wave:wave@postgres:5432/wave
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0

# --- Auth --------------------------------------------------------------------
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=change-me
JWT_TTL=900
REFRESH_TOKEN_TTL=2592000
# Secure cookie (HTTPS only). compose.override.yaml sets 0 for the plain-HTTP
# dev stack; prod refuses to boot with 0 (F4, see infra/nginx/snippets/tls-prod.conf).
REFRESH_COOKIE_SECURE=1

# --- Streaming (ADR 001) -----------------------------------------------------
# Must differ from APP_SECRET.
STREAM_SIGNING_KEY=change-me
STREAM_URL_TTL=300

# --- Object storage (MinIO locally) -------------------------------------------
MINIO_ROOT_USER=wave-root
MINIO_ROOT_PASSWORD=change-me
# Application credentials, created by minio-init with access to the two
# buckets only (the root credentials never reach php/worker).
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=wave-app
S3_SECRET_KEY=change-me
S3_USE_PATH_STYLE=1
S3_BUCKET_PRIVATE=wave-private
S3_BUCKET_PUBLIC=wave-public

# --- Media worker --------------------------------------------------------------
FFMPEG_BIN=/usr/bin/ffmpeg
FFPROBE_BIN=/usr/bin/ffprobe

# --- Mail ----------------------------------------------------------------------
MAILER_DSN=smtp://mailpit:1025
MAILER_FROM="Wave <no-reply@wave.local>"

# --- Front -------------------------------------------------------------------
VITE_API_BASE_URL=/api/v1
